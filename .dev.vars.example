# Copy to .dev.vars and fill in your credentials. Never commit the real file.
# Wrangler loads .dev.vars for local development; deployment does not upload it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
RESYNC_SECRET=""
CONTACT_FORM_URL=""

# GOOGLE_SHEET_ID inherits wrangler.toml. Uncomment to use a different sheet.
# GOOGLE_SHEET_ID="your-sheet-id"
SHEET_RANGE="Products!A1:J"
SITE_URL="http://localhost:8787"

# Set true after entering credentials to load an empty local cache from Sheets.
# Leave false to preview demo products without Google credentials.
LOCAL_SYNC_ON_EMPTY="false"
